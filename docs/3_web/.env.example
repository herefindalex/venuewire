# V3 backend configuration example — NEVER put real secrets in this tracked file.
# Merge into the existing project .env; do not overwrite existing credentials.
# All addresses below are examples. Replace with the actual two-host deployment.

# Go host B listens on its own private interface, NOT the Nginx host's IP.
WEB_HOST=10.0.0.20
WEB_PORT=8080
WEB_PUBLIC_ORIGIN=https://trade.example.com
# Actual source IP observed by Go for Nginx host A; account for NAT if present.
WEB_TRUSTED_PROXY_CIDRS=10.0.0.10/32

WEB_USERNAME=alex
# Required, >=12 characters. Quote literal passwords containing special characters.
WEB_PASSWORD=
# Required, Base64 encoding of >=32 random bytes. Generate locally, not in chat.
WEB_SESSION_SECRET=
WEB_SESSION_TTL=8h
WEB_DEFAULT_VENUE=bybit
# Shared login: all logged-in viewers can trade when true. Default is view-only.
WEB_TRADING_ENABLED=false

# Project policy defaults, not exchange limits or measured latency.
WEB_PUSH_INTERVAL=250ms
ACCOUNT_RECONCILE_INTERVAL=30s
QUOTE_TTL=5s
TRADE_BOOK_MAX_AGE=3s
VALUATION_PRICE_MAX_AGE=15s
QUICK_TRADE_SLIPPAGE_BPS=50
QUICK_TRADE_MAX_BTC=0.01
QUICK_TRADE_MAX_ETH=1
QUICK_TRADE_MAX_USDT=1000

# V3.1 demo limits. Hourly/concurrent limits cover both venues and all sessions.
# Count persisted submission intents, including rejected, zero-fill and Unknown.
# Retries of the same intent do not count again; Unknown keeps its active slot.
DEMO_MAX_TRADES_PER_SESSION=10
DEMO_MAX_TRADES_PER_HOUR=30
DEMO_MAX_CONCURRENT_TRADES=1
# Source-asset spend caps; also subject to the V3 caps and venue/fee checks.
# These are project policy defaults, not verified exchange instrument limits.
DEMO_MAX_BYBIT_BTC_QTY=0.01
DEMO_MAX_BYBIT_USDT_AMOUNT=1000
DEMO_MAX_DERIBIT_BTC_AMOUNT=0.01
DEMO_MAX_DERIBIT_ETH_AMOUNT=1

# Keep existing exchange configuration names / aliases found during Phase 0.
# Testnet only. Do not copy credentials previously shared in a conversation.
BYBIT_ENV=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_WS_SPOT_URL=wss://stream-testnet.bybit.com/v5/public/spot

DERIBIT_ENABLED=true
DERIBIT_ENV=testnet
DERIBIT_API_KEY=
DERIBIT_API_SECRET=

# Existing account aliases, FIX settings and state paths must be preserved.
# Do not add VITE_ variables for any secret or exchange credentials.
# No Go TLS_CERT_FILE / TLS_KEY_FILE: existing upstream Nginx terminates TLS.
